{
  "name": "vin-react",
  "version": "7.1.3",
  "description": "This library is exclusive for react that utilize the flexbox.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./lib/components": {
      "import": "./lib/components/index.js",
      "types": "./lib/components/index.d.ts"
    },
    "./lib/floating": {
      "import": "./lib/floating/index.js",
      "types": "./lib/floating/index.d.ts"
    },
    "./lib/utils": {
      "import": "./lib/utils/index.js",
      "types": "./lib/utils/index.d.ts"
    }
  },
  "scripts": {
    "prepare": "npx ts-patch install",
    "types": "npx tspc",
    "clean": "rm -rf ./lib",
    "bundle": "npm run types; npx webpack --config ./config/webpack.config.js",
    "build": "npm run clean && npm run bundle; npm run types",
    "dev": "npm-watch"
  },
  "watch": {
    "bundle": {
      "patterns": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css"
      ],
      "extensions": "ts,tsx,css",
      "ignore": [
        "node_modules",
        "lib"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/petatemarvin26/vin-react.git"
  },
  "keywords": [
    "react",
    "webpack",
    "DOM"
  ],
  "author": {
    "name": "Marvin Petate",
    "email": "petatemarvin26@gmail.com",
    "url": "https://marvin-petate.web.app"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/petatemarvin26/vin-react/issues"
  },
  "homepage": "https://github.com/petatemarvin26/vin-react#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "npm-watch": "^0.13.0",
    "style-loader": "^4.0.0",
    "ts-patch": "^4.0.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
