{
  "name": "vin-react",
  "version": "2.0.3",
  "description": "This library is exclusive for react that utilize the flexbox.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./lib/float": {
      "import": "./lib/float/index.js",
      "types": "./lib/float/index.d.ts"
    },
    "./lib/components": {
      "import": "./lib/components/index.js",
      "types": "./lib/components/index.d.ts"
    },
    "./lib/utils": {
      "import": "./lib/utils/index.js",
      "types": "./lib/utils/index.d.ts"
    },
    "./lib/hoc": {
      "import": "./lib/hoc/index.js",
      "types": "./lib/hoc/index.d.ts"
    }
  },
  "scripts": {
    "prepare": "npx ts-patch install",
    "types": "npx tspc",
    "clean": "rm -rf ./lib",
    "bundle": "npx webpack --config ./config/webpack.config.js",
    "build": "npm run clean && npm run bundle && npm run types"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/petatemarvin26/vin-react.git"
  },
  "keywords": [
    "react",
    "webpack",
    "DOM"
  ],
  "author": {
    "name": "Marvin Petate",
    "email": "petatemarvin26@gmail.com",
    "url": "https://marvin-petate.web.app"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/petatemarvin26/vin-react/issues"
  },
  "homepage": "https://github.com/petatemarvin26/vin-react#readme",
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@babel/preset-env": "^7.24.3",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@svgr/webpack": "^8.0.1",
    "@types/react": "^18.0.32",
    "@types/react-dom": "^18.2.6",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.7.3",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "style-loader": "^3.3.2",
    "ts-patch": "^3.2.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.0.3",
    "typescript-transform-paths": "^3.4.7",
    "url-loader": "^4.1.1",
    "webpack": "^5.77.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
